@model prac8.Models.InventoryItem

@{
    ViewBag.Title = "Delete Inventory Product";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card card-custom p-4 border-start border-danger border-4">
            <div class="border-bottom pb-3 mb-4">
                <span class="badge bg-danger mb-2">Confirm Delete Action</span>
                <h3 class="fw-bold text-danger mb-1">Delete Inventory Item</h3>
                <p class="text-muted small mb-0">Are you sure you want to permanently delete this item from the database via ADO.NET?</p>
            </div>

            <div class="table-responsive mb-4">
                <table class="table table-bordered">
                    <tbody>
                        <tr>
                            <th class="bg-light" style="width: 35%;">Item ID</th>
                            <td>#@Model.ItemId</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Item Name</th>
                            <td class="fw-bold">@Model.ItemName</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Category</th>
                            <td>@Model.Category</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Quantity in Stock</th>
                            <td>@Model.Quantity units</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Unit Price</th>
                            <td>₹@String.Format("{0:N2}", Model.UnitPrice)</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Description</th>
                            <td>@(string.IsNullOrEmpty(Model.Description) ? "N/A" : Model.Description)</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Date Added</th>
                            <td>@Model.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            @using (Html.BeginForm("Delete", "Inventory", new { id = Model.ItemId }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="d-flex justify-content-between align-items-center border-top pt-3">
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4">Cancel</a>
                    <button type="submit" class="btn btn-danger px-4">
                        Confirm Delete (ADO.NET Delete)
                    </button>
                </div>
            }
        </div>
    </div>
</div>
