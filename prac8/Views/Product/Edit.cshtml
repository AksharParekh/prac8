@model Practical8.Models.Product

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Edit Product</title>
</head>
<body>
    <h2>Edit Product</h2>
    @using (Html.BeginForm())
    {
        @Html.HiddenFor(m => m.ProductId)
        <table>
            <tr>
                <td>Product ID:</td>
                <td>@Model.ProductId</td>
            </tr>
            <tr>
                <td>Product Name:</td>
                <td>@Html.TextBoxFor(m => m.ProductName)</td>
            </tr>
            <tr>
                <td>Quantity:</td>
                <td>@Html.TextBoxFor(m => m.Quantity)</td>
            </tr>
            <tr>
                <td>Price:</td>
                <td>@Html.TextBoxFor(m => m.Price)</td>
            </tr>
        </table>
        <br />
        <input type="submit" value="Update" />
        <p>@Html.ActionLink("Back to List", "Index")</p>
    }
</body>
</html>
