@model IEnumerable<prac8.Models.InventoryItem>

@{
    ViewBag.Title = "Inventory Dashboard";
}

<!-- Summary Statistics Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card card-custom p-3 border-start border-primary border-4">
            <div class="text-muted small text-uppercase fw-bold">Total Products</div>
            <div class="fs-3 fw-bold text-primary">@ViewBag.TotalItems</div>
            <div class="small text-muted">Unique SKUs in catalog</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 border-start border-success border-4">
            <div class="text-muted small text-uppercase fw-bold">Total Stock Units</div>
            <div class="fs-3 fw-bold text-success">@ViewBag.TotalQuantity</div>
            <div class="small text-muted">Units physically stored</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 border-start border-info border-4">
            <div class="text-muted small text-uppercase fw-bold">Total Valuation</div>
            <div class="fs-3 fw-bold text-info">₹@String.Format("{0:N2}", ViewBag.TotalValuation)</div>
            <div class="small text-muted">Cumulative stock value</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 border-start border-warning border-4">
            <div class="text-muted small text-uppercase fw-bold">Low Stock Alerts</div>
            <div class="fs-3 fw-bold text-warning">@ViewBag.LowStockCount</div>
            <div class="small text-muted">Items with quantity &lt; 10</div>
        </div>
    </div>
</div>

<!-- Controls: Filter & Add Button -->
<div class="card card-custom p-4 mb-4">
    <div class="row align-items-center">
        <div class="col-lg-8">
            @using (Html.BeginForm("Index", "Inventory", FormMethod.Get, new { @class = "row g-2 align-items-center" }))
            {
                <div class="col-auto">
                    <label class="form-label mb-0 fw-semibold">Search:</label>
                </div>
                <div class="col-md-4">
                    @Html.TextBox("searchTerm", ViewBag.CurrentSearch as string, new { @class = "form-control form-control-sm", placeholder = "Search by item or description..." })
                </div>
                <div class="col-auto">
                    <label class="form-label mb-0 fw-semibold">Category:</label>
                </div>
                <div class="col-md-3">
                    @Html.DropDownList("categoryFilter", ViewBag.Categories as SelectList, new { @class = "form-select form-select-sm" })
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary btn-sm px-3">Filter</button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">Reset</a>
                </div>
            }
        </div>
        <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
            <a href="@Url.Action("Create")" class="btn btn-success">
                + Add New Product
            </a>
        </div>
    </div>
</div>

<!-- Inventory Products Table -->
<div class="card card-custom p-0 overflow-hidden">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="m-0 fw-bold text-dark">Inventory Items (ADO.NET Data Table)</h5>
        <span class="badge bg-secondary">@Model.Count() records loaded</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" style="width: 70px;">ID</th>
                    <th scope="col">Item Name</th>
                    <th scope="col">Category</th>
                    <th scope="col" class="text-center">Stock Quantity</th>
                    <th scope="col" class="text-end">Unit Price</th>
                    <th scope="col" class="text-end">Subtotal</th>
                    <th scope="col">Date Added</th>
                    <th scope="col" class="text-center" style="width: 220px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <em>No inventory items found matching your criteria.</em>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        decimal subtotal = item.Quantity * item.UnitPrice;
                        <tr>
                            <td class="fw-bold text-muted">#@item.ItemId</td>
                            <td>
                                <div class="fw-bold text-dark">@item.ItemName</div>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <small class="text-muted d-block text-truncate" style="max-width: 260px;">@item.Description</small>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.Category</span>
                            </td>
                            <td class="text-center">
                                @if (item.Quantity == 0)
                                {
                                    <span class="badge bg-danger">Out of Stock (0)</span>
                                }
                                else if (item.Quantity < 10)
                                {
                                    <span class="badge bg-warning text-dark">Low Stock (@item.Quantity)</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@item.Quantity in stock</span>
                                }
                            </td>
                            <td class="text-end fw-semibold">
                                ₹@String.Format("{0:N2}", item.UnitPrice)
                            </td>
                            <td class="text-end fw-bold text-primary">
                                ₹@String.Format("{0:N2}", subtotal)
                            </td>
                            <td class="small text-muted">
                                @item.CreatedDate.ToString("yyyy-MM-dd HH:mm")
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a href="@Url.Action("Edit", new { id = item.ItemId })" class="btn btn-outline-primary" title="Edit">
                                        Edit
                                    </a>
                                    <a href="@Url.Action("Details", new { id = item.ItemId })" class="btn btn-outline-info" title="Details">
                                        Details
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = item.ItemId })" class="btn btn-outline-danger" title="Delete">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
